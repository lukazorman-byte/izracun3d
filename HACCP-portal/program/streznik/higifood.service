# Namestitev brez Dockerja (Linux, systemd): kopirajte projekt v /opt/higifood, nato
#   sudo cp higifood.service /etc/systemd/system/ && sudo systemctl enable --now higifood
# Pred njim postavite HTTPS posredniški strežnik (npr. Caddy, glej Caddyfile; reverse_proxy 127.0.0.1:3000).
[Unit]
Description=HiGiFood HACCP
After=network.target

[Service]
WorkingDirectory=/opt/higifood
Environment=HOST=127.0.0.1 PORT=3000 HACCP_PROXY=1 NODE_ENV=production
ExecStart=/usr/bin/node server.js
Restart=always
User=higifood

[Install]
WantedBy=multi-user.target
